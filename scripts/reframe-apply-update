#!/bin/bash
set -euo pipefail

REPO_PATH="/home/cam/reframe"
CAM_HOME="/home/cam"
VENV_PATH="$REPO_PATH/.venv"

if [ "$(id -u)" -ne 0 ]; then
    echo "reframe-apply-update must run as root" >&2
    exit 1
fi

required_files=(
    requirements.txt
    scripts/enable_hdr.sh
    scripts/reframe-apply-update
    scripts/reframe-python
    scripts/reframe-rtc-sync
    static/dashboard.css
    static/dashboard.js
    systemd/reframe.service
    systemd/reframe-dashboard.service
    systemd/reframe-dashboard-proxy.service
    systemd/reframe-rtc-restore.service
    systemd/reframe-rtc-update.service
    templates/dashboard.html
)

for required in "${required_files[@]}"; do
    if [ ! -f "$REPO_PATH/$required" ]; then
        echo "Missing update file: $required" >&2
        exit 1
    fi
done

if ! dpkg-query -W -f='${Status}' python3-venv 2>/dev/null | grep -q "install ok installed"; then
    apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv
fi

runuser -u cam -- env HOME="$CAM_HOME" /usr/bin/python3 -m venv --system-site-packages "$VENV_PATH"
runuser -u cam -- env HOME="$CAM_HOME" PYTHONNOUSERSITE=1 "$VENV_PATH/bin/python" -m pip install -r "$REPO_PATH/requirements.txt"

install -o root -g root -m 0755 "$REPO_PATH/scripts/reframe-apply-update" /usr/local/sbin/reframe-apply-update
install -o root -g root -m 0755 "$REPO_PATH/scripts/reframe-rtc-sync" /usr/local/sbin/reframe-rtc-sync
install -o root -g root -m 0644 "$REPO_PATH/systemd/reframe.service" /etc/systemd/system/reframe.service
install -o root -g root -m 0644 "$REPO_PATH/systemd/reframe-dashboard.service" /etc/systemd/system/reframe-dashboard.service
install -o root -g root -m 0644 "$REPO_PATH/systemd/reframe-dashboard-proxy.service" /etc/systemd/system/reframe-dashboard-proxy.service
install -o root -g root -m 0644 "$REPO_PATH/systemd/reframe-rtc-restore.service" /etc/systemd/system/reframe-rtc-restore.service
install -o root -g root -m 0644 "$REPO_PATH/systemd/reframe-rtc-update.service" /etc/systemd/system/reframe-rtc-update.service
install -d -o root -g root -m 0755 /var/lib/reframe
chmod 0755 "$REPO_PATH/scripts/enable_hdr.sh"
chmod 0755 "$REPO_PATH/scripts/reframe-python"
timedatectl set-timezone UTC
timedatectl set-ntp true

if [ -f /etc/default/pisugar-server ]; then
    sed -i -E 's|--tcp[[:space:]]+0\.0\.0\.0:8423|--tcp 127.0.0.1:8423|' /etc/default/pisugar-server
fi

systemctl daemon-reload
systemctl enable reframe-rtc-restore.service reframe-rtc-update.service

echo "Dependencies and service files updated; reboot to run the new code."
